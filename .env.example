# Mot de passe Postgres (docker-compose.prod.yml). Doit correspondre à DATABASE_URL.
POSTGRES_PASSWORD=kintrafic
DATABASE_URL=postgresql+psycopg://kintrafic:kintrafic@127.0.0.1:5432/kintrafic
# Railway colle postgres:// ou postgresql:// — l’app le réécrit en postgresql+psycopg://.
SECRET_KEY=change-me-in-production
ADMIN_LOGIN=osee
ADMIN_PASSWORD=KinTrafic-Local-2026!
# En local, TOTP désactivé pour ouvrir le dashboard. En production: true.
ADMIN_TOTP_REQUIRED=false
# Local: 43147. Docker / Railway: start.sh écoute $PORT (défaut 8080). Ne pas figer 43147 dans Railway.
APP_PORT=43147
PUBLIC_ORIGIN=http://127.0.0.1:43147
# Fuseau des logs / du conteneur. Les profils horaires sont déjà Africa/Kinshasa dans le code.
TZ=Africa/Kinshasa
# Tuiles via le cache serveur (HOT OSM-FR). Ne pas exposer tile.openstreetmap.org aux téléphones.
TILE_UPSTREAM=https://a.tile.openstreetmap.fr/hot
MOCK_PAYMENTS=true
MOCK_OTP=true
SEED_DEMO=true
VEILLE_ENABLED=true
VEILLE_INTERVAL_SEC=900
VEILLE_MIN_INTERVAL_SEC=120
VEILLE_OSM_NOTES=true
VEILLE_RSS_URLS=
VEILLE_FALLBACK_SAMPLE=true
VEILLE_SNAP_M=120
VEILLE_USER_AGENT=KinTraficLive/1.0 (veille-autonome; +http://127.0.0.1:43147)
